<Window
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:model="using:ModelLib"
xmlns:local="using:Lab2App"
x:DataType="local:MainWindow"
x:Class="Lab2App.MainWindow"
mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
Title="Lab2App"
>
  <Window.Resources>
    <DataTemplate x:Key="DataItemTemplate" x:DataType="model:DataItem">
      <Border Padding="8" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock Text="{Binding Name}"/>
          <TextBlock Text="{Binding Date, StringFormat='Date: {0:d}'}"/>
          <TextBlock Text="{Binding N, StringFormat='N: {0}'}"/>
        </StackPanel>
      </Border>

    </DataTemplate>

    <local:ItemInfoConverter x:Key="ItemInfoConverter"/>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,10,10" Text="Collection without DataTemplate"/>
    <ListBox Grid.Column="0" Grid.Row="1" Margin="0,0,10,10" ItemsSource="{ReflectionBinding Items}"/>
    <Button Grid.Column="0" Grid.Row="2" Margin="0,0,10,0" Content="Update" Click="UpdateButton_OnClick"/>

    <TextBlock Grid.Column="1" Grid.Row="0" Margin="0,0,10,10" Text="DataCollection"/>
    <ListBox Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Margin="0,0,10,10"
             x:Name="TemplatedListBox"
             ItemsSource="{ReflectionBinding Items}" ItemTemplate="{StaticResource DataItemTemplate}"/>
    <TextBlock Grid.Column="1" Grid.Row="2" Margin="0,0,10,0" Text="Selected item info"/>
    <TextBlock Grid.Column="1" Grid.Row="3" Margin="0,0,10,0">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource ItemInfoConverter}">
          <ReflectionBinding Path="#TemplatedListBox.SelectedItem.N"/>
          <ReflectionBinding Path="#TemplatedListBox.SelectedItem.Bounds"/>
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </Grid>
</Window>